{
  "name": "gestao-nexus-backend",
  "version": "0.1.0",
  "description": "API da ferramenta de gestão da Nexus",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node db/scripts/migrate.js",
    "seed": "node db/scripts/seed.js",
    "pessoas": "node db/scripts/listar-pessoas.js",
    "exportar-despesas": "node db/scripts/exportar-despesas.js",
    "relatorio-mensal": "node db/scripts/relatorio-mensal.js",
    "resetar-senha": "node db/scripts/resetar-senha.js",
    "acesso-restrito": "node db/scripts/definir-acesso-restrito.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "gestao-nexus": "file:..",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "file:../..": true

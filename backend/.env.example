# ============================================
# Configuração do Backend — Gestão Nexus
# (Sprint 1.5 — Representantes)
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no git.

# Ambiente (development | production)
NODE_ENV=development

# Porta do backend
PORT=3001

# ============================================
# Banco de dados PostgreSQL
# ============================================
# No Railway, DATABASE_URL é injetada automaticamente quando você
# anexa um serviço Postgres. Localmente, preencha com seus dados.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/gestao_nexus

# ============================================
# Autenticação
# ============================================
# Segredo usado para assinar os tokens JWT.
# Gere um valor aleatório e longo (ex: openssl rand -base64 48).
JWT_SECRET=troque-este-valor-por-algo-aleatorio-e-longo-em-producao

# Tempo de expiração do token (ex: 7d, 12h, 60m)
JWT_EXPIRES_IN=7d

# ============================================
# Seed inicial — Pessoa de acesso administradora
# ============================================
# Cria o primeiro usuário administrador na rodagem do "npm run seed".
# É esta pessoa que loga na ferramenta. Pode estar vinculada a um sócio
# (como "titular") ou só administrar os cadastros, sem representar ninguém.
SEED_ADMIN_NOME=Administrador Nexus
SEED_ADMIN_EMAIL=admin@nexus.com.br
SEED_ADMIN_SENHA=MudarDepoisDoPrimeiroLogin123!
SEED_ADMIN_PERCENTUAL=0

# ============================================
# (Opcional) Primeiro sócio criado junto com o admin
# ============================================
# Se SEED_SOCIO_NOME estiver preenchido, o seed cria um sócio e amarra
# o administrador acima como "titular" desse sócio (o cenário mais comum
# quando o próprio fundador se cadastra pra usar a ferramenta).
# Se deixar em branco, o seed cria só o administrador "puro".
#
# SEED_SOCIO_NOME=Marcio Nascimento
# SEED_SOCIO_TIPO_PESSOA=fisica            # fisica | juridica
# SEED_SOCIO_DOCUMENTO=000.000.000-00      # CPF ou CNPJ
# SEED_SOCIO_EMAIL=marcio@nexus.com.br
# SEED_SOCIO_TELEFONE=(92) 9 9999-9999
# SEED_SOCIO_PERCENTUAL=100

# ============================================
# CORS
# ============================================
# Em dev, o frontend Vite roda em outra porta. Em produção, o backend
# serve o frontend no mesmo host, então pode deixar vazio.
CORS_ORIGIN=http://localhost:5173

# ============================================
# ASAAS (Sprint 2)
# ============================================
# Chave de API do ASAAS. Pegue em:
#   Sandbox  → https://sandbox.asaas.com (Minha Conta > Integrações)
#   Produção → https://www.asaas.com (Minha Conta > Integrações)
#
# Se ficar vazia, a integração simplesmente não roda (o cron não dispara
# e o painel de Caixa mostra que a integração não está conectada).
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Janela de busca. Mudar só se a operação exigir. Default: próximos 90
# dias + 7 dias pra trás (pra pegar vencidos recentes que podem virar recebidos).
ASAAS_JANELA_DIAS_FUTURO=90
ASAAS_JANELA_DIAS_PASSADO=7

# Cron de sincronização automática. Default: todo dia às 5h no horário
# de São Paulo. Formato padrão cron (min hora dia mês diasemana).
SYNC_ASAAS_ATIVO=true
SYNC_ASAAS_CRON=0 5 * * *
SYNC_ASAAS_TIMEZONE=America/Sao_Paulo

# ============================================
# Uploads de arquivos (Sprint 6)
# ============================================
# Pasta onde os arquivos enviados (atas, contratos sociais) são
# guardados. Em desenvolvimento, pode ficar como 'uploads' (cria a
# pasta backend/uploads/). Em produção no Railway, ESTA PASTA PRECISA
# DE UM VOLUME PERSISTENTE — senão os arquivos somem em cada redeploy.
#
# Como configurar no Railway:
#   1. No projeto, adicionar Volume com Mount Path = /data
#   2. Definir UPLOADS_DIR=/data/uploads
UPLOADS_DIR=uploads

# Tamanho máximo de cada arquivo, em MB.
UPLOADS_MAX_MB=10

# ============================================
# E-mails / Notificações (Sprint 7)
# ============================================
# Chave da API do Resend (https://resend.com/api-keys).
# Se ficar vazia, o app não envia e-mails (mas as notificações in-app
# do sino continuam funcionando). Em dev local, deixar vazio é OK.
RESEND_API_KEY=

# Remetente que aparece nos e-mails.
#   - Em sandbox/teste do Resend: 'Gestão Nexus <onboarding@resend.dev>'
#     (só entrega ao dono da conta Resend, mas funciona sem verificar domínio)
#   - Em produção: precisa de domínio verificado no painel do Resend
#     (ex: 'Gestão Nexus <noreply@nexus.com.br>')
EMAIL_FROM=Gestão Nexus <onboarding@resend.dev>

# URL pública do app. Vai dentro dos links dos e-mails ("Clique pra votar...").
# Em dev: http://localhost:5173. Em produção: https://seu-app.up.railway.app
# (ou o domínio personalizado que você configurar).
APP_URL=http://localhost:5173

# Cron de notificações diárias (contas vencendo, lembretes). Mesmo formato
# do node-cron. Default: 8h da manhã, horário de São Paulo.
NOTIFICACOES_ATIVO=true
NOTIFICACOES_CRON=0 8 * * *
NOTIFICACOES_TIMEZONE=America/Sao_Paulo

